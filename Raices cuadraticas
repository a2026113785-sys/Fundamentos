#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    float a,b,c;
    cout<<"ingresar el valor de a:";
    cin>>a;
    cout<<"ingresar el valor de b:";
    cin>>b;
    cout<<"ingresar el valor de c:";
    cin>>c;
    
    double x1,x2;
    
    x1=(-b+sqrt(b*b-4*a*c))/(2*a);
    x2=(-b-sqrt(b*b-4*a*c))/(2*a);
    
    cout<<"el valor de x1 es:"<<x1<<endl;
    cout<<"el valor de x2 es:"<<x2;
    return 0;
}
