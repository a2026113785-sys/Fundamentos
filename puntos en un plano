#include <iostream>
#include <math.h>
using namespace std;
int main()
{
    float x1,y1,x2,y2,d;
    
    cout<<"Ingrese x del punto 1:  ";
    cin>>x1;
    cout<<"Ingrese y del punto 1:  ";
    cin>>y1;
    cout<<"Ingrese x del punto 2:  ";
    cin>>x2;
    cout<<"Ingrese y del punto 2:  ";
    cin>>y2;
    
    d=sqrt(pow((x2-x1),2))+pow((y2-y1),2);
    
    cout<<"La distancia entre los puntos es:  "<<d;
    return 0;
    
}
