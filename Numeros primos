#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    int n;
    cout<<"Ingrese un numero:  ";
    cin>>n;
    for(int i=2;i<=sqrt(n);i++)
        if (n%i==0) {
            cout<<"El numero no es primo";
            return 0;
        }
            
    cout<<"El numero es primo";
    return 0;
}
